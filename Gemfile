# frozen_string_literal: true

source "https://rubygems.org"

# Matches the gem set GitHub Pages actually runs in production.
# See https://pages.github.com/versions/ for the locked versions
# of jekyll and bundled plugins.
gem "github-pages", group: :jekyll_plugins

# Webrick is no longer bundled with Ruby 3+; needed for `jekyll serve`.
gem "webrick", "~> 1.7"
